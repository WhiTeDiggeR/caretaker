extends Node3D

## Art showroom (scenes/sandbox/art_showroom.tscn, generated by tools/props/make_showroom.py): F1 shows or hides the
## debug labels of the props, rows and swatches (#207). Their size, wrapping, staggering and fade with distance are
## set by the generator.

const LABEL_GROUP := &"showroom_labels"
const TOGGLE_KEY := KEY_F1
const HINT := "F1 — подписи"

var _labels: Array[Node] = []
var _shown := true
var _hint: Label


func _ready() -> void:
	_labels = get_tree().get_nodes_in_group(LABEL_GROUP)
	var layer := CanvasLayer.new()
	add_child(layer)
	_hint = Label.new()
	_hint.position = Vector2(12, 8)
	_hint.modulate = Color(1, 1, 1, 0.6)
	layer.add_child(_hint)
	_update_hint()


func _unhandled_input(event: InputEvent) -> void:
	var key := event as InputEventKey
	if key == null or not key.pressed or key.echo or key.keycode != TOGGLE_KEY:
		return
	set_labels_visible(not _shown)
	get_viewport().set_input_as_handled()


## Shows or hides every showroom label.
func set_labels_visible(shown: bool) -> void:
	_shown = shown
	for label: Node in _labels:
		(label as Node3D).visible = shown
	_update_hint()


func _update_hint() -> void:
	_hint.text = "%s: %s" % [HINT, "вкл" if _shown else "выкл"]
