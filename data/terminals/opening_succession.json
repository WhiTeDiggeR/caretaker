{
  "id": "opening_succession",
  "title": "АВАРИЙНОЕ УПРАВЛЕНИЕ · ОПЕРАТОРСКАЯ ОП-1",
  "start": "main",
  "screens": {
    "main": {
      "redirects": [
        {
          "if": {
            "access": "caretaker"
          },
          "goto": "caretaker_main"
        }
      ],
      "lines": [
        "АВАРИЙНОЕ УПРАВЛЕНИЕ КОМПЛЕКСОМ.",
        {
          "text": "Вставьте личный ключ.",
          "if": {
            "not_flag": "senior_key_taken"
          }
        },
        {
          "text": "Ключ: принят. Владелец: старший ████. Статус владельца: нет отклика.",
          "if": {
            "flag": "senior_key_taken"
          }
        }
      ],
      "options": [
        {
          "text": "Протокол преемственности",
          "goto": "protocol",
          "requires": {
            "flag": "senior_key_taken"
          },
          "locked_text": "нужен личный ключ"
        },
        {
          "text": "Выход",
          "action": "exit"
        }
      ]
    },
    "protocol": {
      "lines": [
        "ПРОТОКОЛ ПРЕЕМСТВЕННОСТИ",
        "Ключ не даёт права действовать от имени владельца.",
        {
          "text": "Поиск штатных операторов…",
          "wait": 1.0
        },
        {
          "text": "Найдено: 0",
          "wait": 1.4
        },
        {
          "text": "Поиск резервных операторов…",
          "wait": 1.0
        },
        {
          "text": "Найдено: 0",
          "wait": 1.4
        },
        {
          "text": "Поиск сотрудников с действующим пропуском вне цикла сна…",
          "wait": 1.2
        },
        {
          "text": "Найдено: 1 — ОХРАННИК, ТАБ. № 2-117.",
          "wait": 1.6
        },
        {
          "text": "Назначение: ВРЕМЕННЫЙ СМОТРИТЕЛЬ.",
          "wait": 1.2
        },
        "Аварийные полномочия ограничены: доступ выдаётся только к модулям с опасной нестабильностью."
      ],
      "effects": [
        {
          "grant_access": "caretaker"
        },
        {
          "grant_access": "module_4"
        },
        {
          "set_flag": "caretaker_assigned"
        },
        {
          "set_objective": {
            "id": "reach_module_4",
            "text": "Добраться до модуля 4"
          }
        },
        {
          "event": "caretaker_assigned"
        }
      ],
      "next": "monitor"
    },
    "monitor": {
      "lines": [
        "МОНИТОР МОДУЛЕЙ СОДЕРЖАНИЯ",
        "{containment_monitor}",
        "Аварийный блок персонала — цикл сна. Команда на пробуждение: недоступна."
      ],
      "options": [
        {
          "text": "Назад",
          "goto": "caretaker_main"
        },
        {
          "text": "Выход",
          "action": "exit"
        }
      ]
    },
    "caretaker_main": {
      "lines": [
        "ВРЕМЕННЫЙ СМОТРИТЕЛЬ — АВАРИЙНЫЕ ПОЛНОМОЧИЯ.",
        "Модуль 4: требуется обслуживание."
      ],
      "options": [
        {
          "text": "Монитор модулей",
          "goto": "monitor"
        },
        {
          "text": "Выход",
          "action": "exit"
        }
      ]
    }
  }
}
