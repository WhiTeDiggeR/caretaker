{
  "id": "opening_succession",
  "title": "АВАРИЙНОЕ УПРАВЛЕНИЕ · ОПЕРАТОРСКАЯ ОП-1",
  "era": "module",
  "start": "main",
  "screens": {
    "main": {
      "redirects": [
        {
          "if": {
            "access": "caretaker"
          },
          "goto": "caretaker_main"
        }
      ],
      "lines": [
        "АВАРИЙНОЕ УПРАВЛЕНИЕ КОМПЛЕКСОМ.",
        "Терминал старшего смены. Вход — по личному ключу.",
        {
          "text": "Вставьте личный ключ.",
          "if": {
            "not_flag": "senior_key_taken"
          }
        },
        {
          "text": "Ключ вставлен. Требуется проверка.",
          "if": {
            "flag": "senior_key_taken",
            "not_flag": "opening/succession_key_checked"
          }
        },
        {
          "text": "Ключ: подлинный. Владелец: старший смены ████.",
          "if": {
            "flag": "opening/succession_key_checked"
          }
        },
        {
          "text": "Оператор: охранник, таб. № 2-117 — не владелец ключа.",
          "if": {
            "flag": "opening/succession_operator_identified"
          }
        },
        {
          "text": "Смотритель комплекса: нет отклика.",
          "if": {
            "flag": "opening/succession_status_checked"
          }
        }
      ],
      "options": [
        {
          "text": "Проверка ключа",
          "goto": "key_check",
          "requires": {
            "flag": "senior_key_taken"
          },
          "locked_text": "нужен личный ключ"
        },
        {
          "text": "Идентификация оператора",
          "goto": "identify",
          "visible_if": {
            "flag": "opening/succession_key_checked"
          }
        },
        {
          "text": "Статус смотрителя",
          "goto": "status",
          "visible_if": {
            "flag": "opening/succession_operator_identified"
          }
        },
        {
          "text": "Протокол преемственности",
          "goto": "protocol",
          "visible_if": {
            "flag": "opening/succession_status_checked"
          }
        },
        {
          "text": "Выход",
          "action": "exit"
        }
      ]
    },
    "key_check": {
      "lines": [
        "ПРОВЕРКА КЛЮЧА",
        {
          "text": "Чтение ключа…",
          "wait": 1.0
        },
        {
          "text": "Ключ: подлинный.",
          "wait": 1.2
        },
        "Владелец ключа: СТАРШИЙ СМЕНЫ ████.",
        "Уровень: аварийное управление комплексом."
      ],
      "effects": [
        {
          "set_flag": "opening/succession_key_checked"
        }
      ],
      "next": "main"
    },
    "identify": {
      "lines": [
        "ИДЕНТИФИКАЦИЯ ОПЕРАТОРА",
        {
          "text": "Считывание пропуска оператора…",
          "wait": 1.0
        },
        {
          "text": "Пропуск: ТАБ. № 2-117 · ОХРАНА.",
          "wait": 1.2
        },
        {
          "text": "Сверка с владельцем ключа…",
          "wait": 1.2
        },
        {
          "text": "НЕ СОВПАДАЕТ. Ключ не принадлежит оператору.",
          "wait": 1.0
        },
        "Действия от имени владельца ключа запрещены."
      ],
      "effects": [
        {
          "set_flag": "opening/succession_operator_identified"
        }
      ],
      "next": "main"
    },
    "status": {
      "lines": [
        "СТАТУС СМОТРИТЕЛЯ",
        "Смотритель комплекса по штату: СТАРШИЙ СМЕНЫ ████.",
        {
          "text": "Запрос по личному браслету…",
          "wait": 1.0
        },
        {
          "text": "Сигнал: нет.",
          "wait": 1.2
        },
        {
          "text": "Вызов по громкой связи…",
          "wait": 1.2
        },
        {
          "text": "Отклик: нет.",
          "wait": 1.4
        },
        "Смотритель не на связи. Разрешён протокол преемственности."
      ],
      "effects": [
        {
          "set_flag": "opening/succession_status_checked"
        }
      ],
      "next": "main"
    },
    "protocol": {
      "lines": [
        "ПРОТОКОЛ ПРЕЕМСТВЕННОСТИ",
        {
          "text": "Поиск штатных операторов…",
          "wait": 1.0
        },
        {
          "text": "Найдено: 0",
          "wait": 1.4
        },
        {
          "text": "Поиск резервных операторов…",
          "wait": 1.0
        },
        {
          "text": "Найдено: 0",
          "wait": 1.4
        },
        {
          "text": "Поиск сотрудников с действующим пропуском вне цикла сна…",
          "wait": 1.2
        },
        {
          "text": "Найдено: 1 — ОХРАННИК, ТАБ. № 2-117.",
          "wait": 1.6
        },
        {
          "text": "Назначение: ВРЕМЕННЫЙ СМОТРИТЕЛЬ.",
          "wait": 1.2
        },
        "Аварийные полномочия ограничены: доступ выдаётся только к модулям с опасной нестабильностью."
      ],
      "effects": [
        {
          "grant_access": "caretaker"
        },
        {
          "grant_access": "module_4"
        },
        {
          "set_flag": "caretaker_assigned"
        },
        {
          "set_objective": {
            "id": "reach_module_4",
            "text": "Добраться до модуля 4"
          }
        },
        {
          "event": "caretaker_assigned"
        }
      ],
      "next": "monitor"
    },
    "monitor": {
      "lines": [
        "МОНИТОР МОДУЛЕЙ СОДЕРЖАНИЯ",
        "{containment_monitor}",
        "Аварийный блок персонала — цикл сна. Массовое пробуждение заблокировано: безопасный маршрут эвакуации не подтверждён."
      ],
      "options": [
        {
          "text": "Назад",
          "goto": "caretaker_main"
        },
        {
          "text": "Выход",
          "action": "exit"
        }
      ]
    },
    "caretaker_main": {
      "lines": [
        "ВРЕМЕННЫЙ СМОТРИТЕЛЬ — АВАРИЙНЫЕ ПОЛНОМОЧИЯ.",
        "Модуль 4: требуется обслуживание."
      ],
      "options": [
        {
          "text": "Монитор модулей",
          "goto": "monitor"
        },
        {
          "text": "Выход",
          "action": "exit"
        }
      ]
    }
  }
}
